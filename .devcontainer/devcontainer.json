{
  "name": "AI Short-Form Video Editor (Python 3.10 + FFmpeg)",

  // Official Python 3.10 image on Debian Bookworm
  "image": "mcr.microsoft.com/devcontainers/python:1-3.10-bookworm",

  // System FFmpeg (ffmpeg + ffprobe) and git, baked into the Codespace
  "features": {
    "ghcr.io/devcontainers/features/ffmpeg:1": {},
    "ghcr.io/devcontainers/features/git:1": {}
  },

  // Installs pip dependencies + downloads the default fonts on first build
  "postCreateCommand": "bash setup.sh",

  // Streamlit dev server
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "Streamlit App",
      "onAutoForward": "openPreview"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    },
    "codespaces": {
      "openFiles": ["README.md", "app.py"]
    }
  },

  // Whisper (CPU) + 1080x1920 rendering want some headroom.
  // Pick a >= 4-core / 8 GB machine type when creating the Codespace.
  "hostRequirements": {
    "memory": "8gb"
  }
}
